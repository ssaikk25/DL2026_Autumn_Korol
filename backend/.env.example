# Backend configuration. Copy this file to `.env` and adjust values if needed.

# SQLite database location (file path or :memory:)
DATABASE_URL=sqlite:///./weather_mood.db

# Open-Meteo endpoints (free, no API key required)
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Weather response cache lifetime, in seconds
WEATHER_CACHE_TTL_SECONDS=600

# Serve deterministic mock data when the external API is unavailable
ENABLE_MOCK_FALLBACK=true

# Optional admin token for write endpoints (POST /api/memes). Leave empty to disable auth.
ADMIN_TOKEN=
